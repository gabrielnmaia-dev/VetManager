# =========================================================
# VetManager - Template de variáveis de ambiente (.env.example)
# =========================================================
# Copie para .env e ajuste os valores:
#   cp .env.example .env
# =========================================================

# ---------- Django ----------
# Gere uma nova: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=troque-por-uma-secret-key-segura
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web

# ---------- PostgreSQL ----------
POSTGRES_DB=vetmanager
POSTGRES_USER=vetmanager_user
POSTGRES_PASSWORD=troque-esta-senha
# Host "db" = nome do serviço no docker-compose (uso dentro dos containers).
# Para rodar o Django fora do Docker, troque "db" por "localhost".
DATABASE_URL=postgres://vetmanager_user:troque-esta-senha@db:5432/vetmanager

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/1

# ---------- Superusuário (deploy) ----------
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin
DJANGO_SUPERUSER_EMAIL=admin@vetmanager.local
