# =========================================================
# VetManager - Variáveis de ambiente de PRODUÇÃO
# =========================================================
# No servidor:  cp .env.prod.example .env.prod
# (o arquivo .env.prod é ignorado pelo git)
# =========================================================

# ---------- Django ----------
# Gere uma NOVA e forte (não reutilize a de dev):
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=troque-por-uma-secret-key-forte-e-unica
# DEBUG é forçado para False em core/settings/prod.py (não precisa setar).

# Lista separada por vírgula. Coloque o IP do servidor e/ou o domínio.
ALLOWED_HOSTS=SEU_IP_AQUI,localhost,127.0.0.1

# Só é necessário quando acessar via domínio + HTTPS (ex.: https://api.seudominio.com)
# ou via Tailscale HTTPS (ex.: https://homelabdev.tailXXXX.ts.net:10000).
# CSRF_TRUSTED_ORIGINS=https://api.seudominio.com,https://homelabdev.tailXXXX.ts.net:10000
# Ative quando tiver certificado TLS configurado no Nginx/Tailscale:
# USE_HTTPS=False

# ---------- Frontend (CORS) ----------
# O frontend continua no Netlify. Para vários, separe por vírgula.
CORS_ALLOWED_ORIGINS=https://vetmanager-letvet.netlify.app
FRONTEND_URL=https://vetmanager-letvet.netlify.app

# ---------- PostgreSQL ----------
POSTGRES_DB=vetmanager
POSTGRES_USER=vetmanager_user
POSTGRES_PASSWORD=troque-por-uma-senha-forte
# Host "db" = nome do serviço no docker-compose.prod.yml.
DATABASE_URL=postgres://vetmanager_user:troque-por-uma-senha-forte@db:5432/vetmanager

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/1

# ---------- Superusuário (criado automaticamente no primeiro start) ----------
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=troque-por-uma-senha-forte
DJANGO_SUPERUSER_EMAIL=admin@seudominio.co
