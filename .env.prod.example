# =========================================================
# VetManager - Variáveis de ambiente de PRODUÇÃO
# =========================================================
# No servidor:  cp .env.prod.example .env.prod
# (o arquivo .env.prod é ignorado pelo git)
# =========================================================

# ---------- Django ----------
# Gere uma NOVA e forte (não reutilize a de dev):
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=troque-por-uma-secret-key-forte-e-unica
# DEBUG é forçado para False em core/settings/prod.py (não precisa setar).

# Lista separada por vírgula. O domínio do Tailscale Funnel e localhost são
# adicionados automaticamente por core/settings/prod.py; inclua aqui o IP do
# servidor e/ou outros domínios que também devam acessar a API.
ALLOWED_HOSTS=serverubunto.tail459c47.ts.net,localhost,127.0.0.1

# Domínio público do Funnel (usado também no CSRF_TRUSTED_ORIGINS).
FUNNEL_HOST=serverubunto.tail459c47.ts.net

# Obrigatório em produção com HTTPS (Tailscale Funnel / Netlify).
# Define SESSION_COOKIE_SECURE, CSRF_COOKIE_SECURE e HSTS.
USE_HTTPS=True

# Domínios confiáveis para CSRF (login no /admin via HTTPS atrás de proxy).
# O front no Netlify e o Funnel já entram por padrão no prod.py; use esta
# variável para adicionar outros (ex.: domínio próprio).
CSRF_TRUSTED_ORIGINS=https://vetmanager-letvet.netlify.app,https://serverubunto.tail459c47.ts.net

# Origem do front no Netlify (também usada como default de CORS e CSRF).
NETLIFY_ORIGIN=https://vetmanager-letvet.netlify.app

# ---------- Frontend (CORS) ----------
# O frontend continua no Netlify. Para vários, separe por vírgula.
CORS_ALLOWED_ORIGINS=https://vetmanager-letvet.netlify.app
FRONTEND_URL=https://vetmanager-letvet.netlify.app

# Cookies JWT: com o proxy /api do Netlify (mesma origem) use Lax.
# Só use None se o front chamar a API diretamente em outro domínio (cross-site).
JWT_COOKIE_SAMESITE=Lax
JWT_COOKIE_SECURE=True

# ---------- PostgreSQL ----------
POSTGRES_DB=vetmanager
POSTGRES_USER=vetmanager_user
POSTGRES_PASSWORD=troque-por-uma-senha-forte
# Host "db" = nome do serviço no docker-compose.prod.yml.
DATABASE_URL=postgres://vetmanager_user:troque-por-uma-senha-forte@db:5432/vetmanager

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/1

# ---------- Rate limiting (throttling) ----------
# Limites por endpoint/IP (ex.: "5/min", "30/min", "20/min").
THROTTLE_LOGIN=5/min
THROTTLE_TOKEN_REFRESH=30/min
THROTTLE_TOKEN_LOGOUT=20/min
THROTTLE_ALTERAR_SENHA=5/min
THROTTLE_ANON=30/min
THROTTLE_USER_BURST=120/min
THROTTLE_USER_SUSTAINED=3000/hour

# ---------- Superusuário (criado automaticamente no primeiro start) ----------
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=troque-por-uma-senha-forte
DJANGO_SUPERUSER_EMAIL=admin@seudominio.com

# ---------- Usuário de recepção/atendente (opcional) ----------
# Se preenchido, o deploy cria o usuário e o adiciona ao grupo "recepcao".
# Deixe em branco para não criar. A senha só é aplicada na criação.
DJANGO_RECEPCAO_USERNAME=
DJANGO_RECEPCAO_PASSWORD=
DJANGO_RECEPCAO_EMAIL=
