# =========================================================
# VetManager - Variáveis de ambiente de PRODUÇÃO (.env.production)
# =========================================================
# Equivalente a .env.prod.example. Use este nome se preferir:
#   cp .env.production.example .env.production
#   ENV_FILE=.env.production docker compose -f docker-compose.prod.yml up -d
# =========================================================

# ---------- Django ----------
SECRET_KEY=troque-por-uma-secret-key-forte-e-unica
# DEBUG é forçado para False em core/settings/prod.py.

ALLOWED_HOSTS=serverubunto.tail459c47.ts.net,localhost,127.0.0.1
FUNNEL_HOST=serverubunto.tail459c47.ts.net
USE_HTTPS=True
CSRF_TRUSTED_ORIGINS=https://vetmanager-letvet.netlify.app,https://serverubunto.tail459c47.ts.net
NETLIFY_ORIGIN=https://vetmanager-letvet.netlify.app

# ---------- Frontend (CORS) ----------
CORS_ALLOWED_ORIGINS=https://vetmanager-letvet.netlify.app
FRONTEND_URL=https://vetmanager-letvet.netlify.app

# Cookies JWT: com o proxy /api do Netlify (mesma origem) use Lax.
JWT_COOKIE_SAMESITE=Lax
JWT_COOKIE_SECURE=True

# ---------- PostgreSQL ----------
POSTGRES_DB=vetmanager
POSTGRES_USER=vetmanager_user
POSTGRES_PASSWORD=troque-por-uma-senha-forte
DATABASE_URL=postgres://vetmanager_user:troque-por-uma-senha-forte@db:5432/vetmanager

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/1

# ---------- Rate limiting ----------
THROTTLE_LOGIN=5/min
THROTTLE_TOKEN_REFRESH=30/min
THROTTLE_TOKEN_LOGOUT=20/min
THROTTLE_ALTERAR_SENHA=5/min
THROTTLE_ANON=30/min
THROTTLE_USER_BURST=120/min
THROTTLE_USER_SUSTAINED=3000/hour

# ---------- Superusuário ----------
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=troque-por-uma-senha-forte
DJANGO_SUPERUSER_EMAIL=admin@seudominio.com

# ---------- Recepção (opcional) ----------
DJANGO_RECEPCAO_USERNAME=
DJANGO_RECEPCAO_PASSWORD=
DJANGO_RECEPCAO_EMAIL=
