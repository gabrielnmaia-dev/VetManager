# =========================================================
# VetManager - Variáveis de ambiente de STAGING
# =========================================================
# No servidor:  cp .env.staging.example .env.staging
# (o .env.staging real não deve ser commitado com segredos)
# =========================================================

# ---------- Django ----------
# Gere uma NOVA chave, diferente da produção:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=troque-por-uma-secret-key-forte-e-unica-de-staging

# Marca o ambiente para os defaults de staging em core/settings/prod.py.
ENVIRONMENT=staging
DJANGO_SETTINGS_MODULE=core.settings.staging

# Hosts aceitos pela API. Inclua o domínio público do proxy/Nginx.
ALLOWED_HOSTS=api-staging.seudominio.com,localhost,127.0.0.1

# Domínio público da API de staging (usado no CSRF e como default de host).
FUNNEL_HOST=api-staging.seudominio.com

# HTTPS de ponta a ponta (Nginx com TLS/certbot na frente do container).
# Se ainda não houver certificado no Nginx, use False temporariamente para
# testar via HTTP; com False, mantenha JWT_COOKIE_SECURE=False também.
USE_HTTPS=True

# Em staging o HSTS começa desligado para não "grudar" no subdomínio de testes.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# ---------- Frontend / CORS ----------
# URL do branch deploy do Netlify. Ajuste para o nome real do site.
NETLIFY_ORIGIN=https://staging--vetmanager-letvet.netlify.app

# Origens exatas do front de staging (Netlify + eventual domínio customizado).
CORS_ALLOWED_ORIGINS=https://staging--vetmanager-letvet.netlify.app,https://staging.seudominio.com
FRONTEND_URL=https://staging--vetmanager-letvet.netlify.app

# Libera qualquer subdomínio *.netlify.app (deploy previews e branch deploys).
# Em staging o default já é True; mantenha explícito para ficar documentado.
CORS_ALLOW_NETLIFY_APP=True
# Opcional: regex adicionais, separadas por vírgula (sem espaços).
# CORS_ALLOWED_ORIGIN_REGEXES=^https://[a-z0-9-]+\.netlify\.app$

# CSRF para o /admin e para o front de staging.
CSRF_TRUSTED_ORIGINS=https://staging--vetmanager-letvet.netlify.app,https://staging.seudominio.com,https://api-staging.seudominio.com

# ---------- Cookies JWT (cross-site) ----------
# O front no Netlify chama a API em api-staging.seudominio.com (outro domínio),
# então o cookie precisa ser SameSite=None + Secure.
JWT_COOKIE_SAMESITE=None
JWT_COOKIE_SECURE=True
# Deixe vazio para cookie host-only no domínio da API.
JWT_COOKIE_DOMAIN=
# Cookies de sessão/CSRF do Django também cross-site no staging.
SESSION_COOKIE_SAMESITE=None
CSRF_COOKIE_SAMESITE=None

# ---------- PostgreSQL ----------
POSTGRES_DB=vetmanager_staging
POSTGRES_USER=vetmanager_staging
POSTGRES_PASSWORD=troque-por-uma-senha-forte-de-staging
# Host "db" = nome do serviço no docker-compose.staging.yml.
DATABASE_URL=postgres://vetmanager_staging:troque-por-uma-senha-forte-de-staging@db:5432/vetmanager_staging

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0

# ---------- Porta / publicação (Docker Compose) ----------
# Porta pública no host (o Nginx de staging faz proxy para ela).
STAGING_APP_PORT=4001
# Interface do host onde a porta será publicada. Use 127.0.0.1 atrás do Nginx.
STAGING_BIND_ADDR=127.0.0.1
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=60

# ---------- Rate limiting (throttling) ----------
THROTTLE_LOGIN=5/min
THROTTLE_TOKEN_REFRESH=30/min
THROTTLE_TOKEN_LOGOUT=20/min
THROTTLE_ALTERAR_SENHA=5/min
THROTTLE_ANON=30/min
THROTTLE_USER_BURST=120/min
THROTTLE_USER_SUSTAINED=3000/hour

# ---------- Superusuário (criado automaticamente no primeiro start) ----------
DJANGO_SUPERUSER_USERNAME=admin-staging
DJANGO_SUPERUSER_PASSWORD=troque-por-uma-senha-forte-de-staging
DJANGO_SUPERUSER_EMAIL=admin-staging@seudominio.com

# ---------- Usuário de recepção/atendente (opcional) ----------
DJANGO_RECEPCAO_USERNAME=
DJANGO_RECEPCAO_PASSWORD=
DJANGO_RECEPCAO_EMAIL=
